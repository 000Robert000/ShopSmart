[Unit]
Description=ShopSmart Express API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=shopsmart
Group=shopsmart
WorkingDirectory=/opt/shopsmart/app/ShopSmart-Starter/backend
EnvironmentFile=/etc/shopsmart/backend.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
