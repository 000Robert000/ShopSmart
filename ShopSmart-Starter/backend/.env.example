DATABASE_URL="postgresql://shopsmart_user:shopsmart_dev@localhost:5432/shopsmart?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Optional AI provider. Leave GEMINI_API_KEY empty to use the built-in catalog rules.
# Never commit a real key or put it in a VITE_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=8000
