DATABASE_URL="postgresql://shopsmart_user:shopsmart_dev@localhost:5432/shopsmart?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Optional AI provider. Leave GEMINI_API_KEY empty to use the built-in catalog rules.
# Never commit a real key or put it in a VITE_ variable.
GEMINI_API_KEY=
# Comma-separated, tried in order. Leave empty for the defaults.
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3-flash-preview,gemini-3.1-flash-lite-preview
AI_TIMEOUT_MS=20000

# Assistant provider: mock (labelled simulated AI), mock-down (simulated outage), gemini (needs GEMINI_API_KEY), none (rules only).
# Empty means gemini when a key is set, otherwise rules only.
AI_PROVIDER=

# Production only (set on EC2 in /etc/shopsmart/backend.env):
# HOST=127.0.0.1
# TRUST_PROXY=1
# COOKIE_SECURE=true
